# Template for android/key.properties (which is gitignored).
# Copy this file to `key.properties` and fill in your real values, OR keep the
# generated one. These point the release build at your upload keystore.
#
# storeFile is resolved relative to android/app/ when relative.
storePassword=your-store-password
keyPassword=your-key-password
keyAlias=upload
storeFile=upload-keystore.jks
